@model List<SchoolInventoryManagement.BLL.DTOs.AssetAssignmentResponseDTO>
@{
    ViewData["Title"] = "My Assets";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-start flex-wrap mb-3" style="gap:12px;">
    <div>
        <h2 class="mb-1">My Assets</h2>
        <p class="text-muted mb-0">
            @Model.Count unit@(Model.Count == 1 ? "" : "s") currently signed out to you.
        </p>
    </div>
    <a asp-controller="AssetRequests" asp-action="Create" class="btn btn-primary">+ New Request</a>
</div>

@if (Model.Any())
{
    <p class="text-muted">
        A unit stays on this list until an Asset Officer records its return, so
        this is what you are accountable for right now. Returns and transfers
        are recorded by an Asset Officer, not from here.
    </p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Asset</th>
                <th>Issued</th>
                <th>Condition when issued</th>
                <th>Issued by</th>
                <th>Remarks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in Model)
            {
                var daysHeld = (int)(DateTime.Now.Date - assignment.AssignmentDate.Date).TotalDays;
                var heldLabel = daysHeld == 0
                    ? "today"
                    : daysHeld == 1 ? "1 day ago" : daysHeld + " days ago";

                <tr>
                    <td><a asp-action="Details" asp-route-id="@assignment.AssetID">@assignment.AssetCode</a></td>
                    <td><div class="fw-semibold">@assignment.AssetName</div></td>
                    <td>
                        <div>@assignment.AssignmentDate.ToString("MMM d, yyyy")</div>
                        <div class="text-muted small">@heldLabel</div>
                    </td>
                    <td>
                        <span class="status-pill status-@assignment.ConditionOnAssignment.ToString().ToLowerInvariant()">
                            @assignment.ConditionOnAssignment
                        </span>
                    </td>
                    <td>@assignment.AssignedByUser.FullName</td>
                    <td>@(string.IsNullOrWhiteSpace(assignment.Remarks) ? "—" : assignment.Remarks)</td>
                    <td><a asp-action="Details" asp-route-id="@assignment.AssetID">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div class="fw-semibold mb-1">Nothing is signed out to you</div>
            <p class="text-muted mb-3">
                Anything issued to you appears here until an Asset Officer
                records its return.
            </p>
            <a asp-controller="AssetRequests" asp-action="Create" class="btn btn-primary">Request an asset</a>
        </div>
    </div>
}
