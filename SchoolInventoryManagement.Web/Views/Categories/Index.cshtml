@model List<SchoolInventoryManagement.BLL.DTOs.CategoryDTO>
@{
    ViewData["Title"] = "Categories";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h2>Categories</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ New Category</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryName</td>
                <td>@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.CategoryID">Edit</a>
                    <form asp-action="Delete" asp-route-id="@category.CategoryID" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0 ms-2">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No categories yet.</p>
}