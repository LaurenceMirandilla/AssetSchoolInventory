@using Microsoft.AspNetCore.Mvc.Rendering
@using SchoolInventoryManagement.Web.Controllers
@using SchoolInventoryManagement.DAL.Constants
@model List<SchoolInventoryManagement.BLL.DTOs.UserResponseDTO>
@{
    ViewData["Title"] = "Users";

    // Reset Password refuses to act on your own account (UserService sends
    // you to Change Password instead), so don't offer the link there.
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var statusFilter = (ViewData["StatusFilter"] as string) ?? UsersController.StatusFilterActive;

    var statusOptions = new SelectList(
        new[]
        {
            UsersController.StatusFilterActive,
            UsersController.StatusFilterInactive,
            UsersController.StatusFilterAll
        },
        statusFilter);
}
@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users</h2>
    <a asp-action="Create" class="btn btn-primary">+ New User</a>
</div>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="status" class="col-form-label">Show</label>
    </div>
    <div class="col-auto">
        @* Html.DropDownList rather than a <select asp-items="...">: there is
           no model property to bind here, and SelectTagHelper throws at RENDER
           time when asp-items appears without asp-for -- a failure the
           compiler cannot catch. The current value round-trips through the
           SelectList constructor above. *@
        @Html.DropDownList(
            "status",
            statusOptions,
            new { @class = "form-select", onchange = "this.form.submit()" })
    </div>
    <div class="col-auto">
        <noscript><button type="submit" class="btn btn-secondary">Apply</button></noscript>
    </div>
</form>

<p class="text-muted">
    Users are never deleted — deactivating one blocks their sign-in while
    keeping every record they're attached to intact. Anonymizing goes further
    and permanently removes the name and email, for someone who has left and
    asked to be forgotten; the records stay, pointing at a tombstone.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Department</th>
            <th>Branch</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var isSelf = user.UserID.ToString() == currentUserId;
            var isAnonymized = AnonymizedUser.IsAnonymizedEmail(user.Email);

            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.RoleName</td>
                <td>@user.DepartmentName</td>
                <td>@user.BranchName</td>
                <td>
                    @user.Status
                    @if (isAnonymized)
                    {
                        <span class="badge bg-secondary ms-1">Anonymized</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.UserID">Edit</a>

                    @* Pointless on an anonymized account -- nobody is left to
                       hand the new password to. *@
                    @if (!isSelf && !isAnonymized)
                    {
                        <a asp-action="ResetPassword" asp-route-id="@user.UserID" class="ms-2">Reset Password</a>
                    }

                    @if (user.Status == "Active")
                    {
                        <form asp-action="Deactivate" asp-route-id="@user.UserID" method="post" class="d-inline"
                              onsubmit="return confirm('Deactivate @user.Email?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(user.RowVersion)" />
                            <button type="submit" class="btn btn-link text-danger p-0 ms-2">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivate" asp-route-id="@user.UserID" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(user.RowVersion)" />
                            <button type="submit" class="btn btn-link text-success p-0 ms-2">Reactivate</button>
                        </form>
                    }

                    @* Irreversible, so it is worded bluntly and asks twice. *@
                    @if (!isSelf && !isAnonymized)
                    {
                        <form asp-action="Anonymize" asp-route-id="@user.UserID" method="post" class="d-inline"
                              onsubmit="return confirm('Permanently remove the name and email for @user.Email?\n\nThis CANNOT be undone. Their history stays, but will no longer name them.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(user.RowVersion)" />
                            <button type="submit" class="btn btn-link text-danger p-0 ms-2">Anonymize</button>
                        </form>
                    }
                </td>
            </tr>
        }

        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-muted text-center py-3">
                    No @(statusFilter == UsersController.StatusFilterAll ? "" : statusFilter.ToLower()) users to show.
                </td>
            </tr>
        }
    </tbody>
</table>
