@model List<SchoolInventoryManagement.BLL.DTOs.AssetResponseDTO>
@{
    ViewData["Title"] = "Assets";
}

<h2>Assets</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="keyword" class="form-control" placeholder="Search name, code, serial..." value="@Context.Request.Query["keyword"]" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Search</button>
    </div>
    @if (User.IsInRole("Asset Officer") || User.IsInRole("Administrator"))
    {
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary">+ New Asset</a>
        </div>
    }
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Model</th>
            <th>Category</th>
            <th>Status</th>
            <th>Condition</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var asset in Model)
        {
            <tr>
                <td>@asset.AssetCode</td>
                <td>@asset.AssetName</td>
                <td>@asset.ModelName</td>
                <td>@asset.CategoryName</td>
                <td>@asset.Status</td>
                <td>@asset.Condition</td>
                <td>@(asset.CurrentLocationName ?? "—")</td>
                <td><a asp-action="Details" asp-route-id="@asset.AssetID">View</a></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No assets found.</p>
}