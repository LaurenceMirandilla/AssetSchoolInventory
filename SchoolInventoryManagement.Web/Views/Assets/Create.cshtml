@model SchoolInventoryManagement.Web.ViewModels.AssetCreateViewModel
@{
    ViewData["Title"] = "New Asset";
}

<h2>New Asset</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="AssetCode" class="form-label"></label>
        <input asp-for="AssetCode" class="form-control" />
        <span asp-validation-for="AssetCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ModelID" class="form-label">Model</label>
        <select asp-for="ModelID" asp-items="ViewBag.Models" class="form-select">
            <option value="">-- Select Model --</option>
        </select>
        <span asp-validation-for="ModelID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AssetName" class="form-label"></label>
        <input asp-for="AssetName" class="form-control" />
        <span asp-validation-for="AssetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionDate" class="form-label"></label>
        <input asp-for="AcquisitionDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionCost" class="form-label"></label>
        <input asp-for="AcquisitionCost" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyInformation" class="form-label"></label>
        <input asp-for="WarrantyInformation" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageURL" class="form-label"></label>
        <input asp-for="ImageURL" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="CurrentLocationID" class="form-label">Location</label>
        <select asp-for="CurrentLocationID" asp-items="ViewBag.Locations" class="form-select">
            <option value="">-- None --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentID" class="form-label">Department</label>
        <select asp-for="DepartmentID" asp-items="ViewBag.Departments" class="form-select">
            <option value="">-- None --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}