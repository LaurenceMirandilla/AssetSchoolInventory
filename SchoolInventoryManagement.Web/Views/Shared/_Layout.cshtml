@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Inventory Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolInventoryManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isApprover = User.IsInRole("Asset Officer") || User.IsInRole("Administrator") || User.IsInRole("Principal");
    var isUserManager = User.IsInRole("Administrator") || User.IsInRole("Principal");
    var isAssetManager = User.IsInRole("Asset Officer") || User.IsInRole("Administrator");
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value;
    var displayName = User.Identity?.Name ?? "";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p[0])).ToUpperInvariant();
    if (initials.Length > 2) initials = initials[..2];

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string[], bool> isActive = controllers =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));
}
<div class="sab-shell">

    @if (isAuthed)
    {
        <aside class="sab-sidebar">
            <a class="sab-brand" asp-controller="Home" asp-action="Index">
                <span class="sab-brand-mark">SAB</span>
                <span class="sab-brand-text">
                    <span class="sab-brand-name d-block">School Inventory</span>
                    <span class="sab-brand-sub">Inventory</span>
                </span>
            </a>

            <ul class="sab-nav">
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Home"}) ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span class="sab-nav-label">Home</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Assets"}) && currentAction != "MyAssets" ? "active" : "")"
                       asp-controller="Assets" asp-action="Index">
                        <span class="sab-nav-label">Assets</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Assets"}) && currentAction == "MyAssets" ? "active" : "")"
                       asp-controller="Assets" asp-action="MyAssets">
                        <span class="sab-nav-label">My Assets</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"AssetRequests"}) ? "active" : "")" asp-controller="AssetRequests" asp-action="MyRequests">
                        <span class="sab-nav-label">My Requests</span>
                    </a>
                </li>

                @if (isApprover)
                {
                    <li class="sab-nav-heading">Approvals</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"AssetRequests"}) ? "active" : "")" asp-controller="AssetRequests" asp-action="Pending">
                            <span class="sab-nav-label">Approvals</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Reports"}) ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <span class="sab-nav-label">Reports</span>
                        </a>
                    </li>
                }

                @if (isAssetManager)
                {
                    <li class="sab-nav-heading">Catalog</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Categories"}) ? "active" : "")" asp-controller="Categories" asp-action="Index">
                            <span class="sab-nav-label">Categories</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Models"}) ? "active" : "")" asp-controller="Models" asp-action="Index">
                            <span class="sab-nav-label">Models</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Locations"}) ? "active" : "")" asp-controller="Locations" asp-action="Index">
                            <span class="sab-nav-label">Locations</span>
                        </a>
                    </li>
                }

                @if (isUserManager)
                {
                    <li class="sab-nav-heading">Organization</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Users"}) ? "active" : "")" asp-controller="Users" asp-action="Index">
                            <span class="sab-nav-label">Users</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Branches"}) ? "active" : "")" asp-controller="Branches" asp-action="Index">
                            <span class="sab-nav-label">Branches</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Departments"}) ? "active" : "")" asp-controller="Departments" asp-action="Index">
                            <span class="sab-nav-label">Departments</span>
                        </a>
                    </li>
                }

                <li class="sab-nav-heading">&nbsp;</li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Notifications"}) ? "active" : "")" asp-controller="Notifications" asp-action="Index">
                        <span class="sab-nav-label">Notifications</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Home"}) && currentAction == "Privacy" ? "active" : "")"
                       asp-controller="Home" asp-action="Privacy">
                        <span class="sab-nav-label">Privacy</span>
                    </a>
                </li>
            </ul>

            <a class="sab-sidebar-cta" asp-controller="AssetRequests" asp-action="Create">
                <span>+</span> New Request
            </a>
        </aside>
    }

    <div class="sab-main">
        <header class="sab-topbar">
            <span class="sab-topbar-title">School Inventory Management</span>

            @if (isAuthed)
            {
                <div class="sab-search sab-search-wrap">
                    <span class="sab-search-icon">&#128269;</span>
                    <form asp-controller="Assets" asp-action="Index" method="get">
                        <input type="text" name="keyword" placeholder="Search assets, codes, serials&hellip;" />
                    </form>
                </div>
            }

            <div class="sab-topbar-right">
                @if (isAuthed)
                {
                    <a class="sab-bell" asp-controller="Notifications" asp-action="Index" title="Notifications">
                        @await Component.InvokeAsync("NotificationBell")
                    </a>

                    <div class="sab-user dropdown">
                        <a href="#" class="sab-user d-flex align-items-center text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="sab-user-text d-none d-sm-block">
                                <span class="sab-user-name d-block">@displayName</span>
                                <span class="sab-user-role">@roleName</span>
                            </span>
                            <span class="sab-avatar">@initials</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">Change Password</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </header>

        <main class="sab-content">
            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success">@TempData["StatusMessage"]</div>
            }
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted py-3 px-4">
            &copy; 2026 - School Inventory Management - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
